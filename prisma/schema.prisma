generator client {
  provider = "prisma-client"
  output   = "../src/prisma-client"
}

datasource db {
  provider = "postgresql"
}

model Partner {
  id           String    @id @default(cuid())
  name         String    @unique
  ownershipBps Int
  sortOrder    Int       @default(0)
  expensesPaid Expense[] @relation("ExpensePaidBy")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Category {
  id        String    @id @default(cuid())
  name      String    @unique
  slug      String    @unique
  color     String
  sortOrder Int       @default(0)
  expenses  Expense[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Expense {
  id          String   @id @default(cuid())
  date        DateTime @db.Date
  amountPence Int
  description String
  notes       String?

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  paidById String
  paidBy   Partner @relation("ExpensePaidBy", fields: [paidById], references: [id], onDelete: Restrict)

  receipt   Receipt?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([date])
  @@index([categoryId])
  @@index([paidById])
  @@index([createdAt])
}

model Receipt {
  id          String   @id @default(cuid())
  expenseId   String   @unique
  url         String
  pathname    String
  filename    String
  contentType String
  size        Int
  uploadedAt  DateTime @default(now())

  expense Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
}
